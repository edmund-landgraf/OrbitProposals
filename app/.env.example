DATABASE_URL=postgresql://appuser:CHANGE_ME@localhost:5432/unwhelm_local
UNWHELM_TENANT_ID=
UNWHELM_CLIENT_ID=
UNWHELM_CLIENT_SECRET=
UNWHELM_SENDER=no-reply@unwhelm.net
UNWH_API_PUBLIC_URL=https://unwhelm.net
UNWH_WEB_PUBLIC_URL=https://unwhelm.net
UNWH_MAGIC_LINK_URL_BASE=https://unwhelm.net/auth/magic-link
UNWH_MCP_PUBLIC_URL=https://mcp.unwhelm.net/mcp
UNWH_MCP_RESOURCE_URL=https://mcp.unwhelm.net/mcp
UNWH_AUTHORIZATION_SERVER=https://unwhelm.net
UNWH_MODEL_API_KEY=
UNWH_MODEL_BASE_URL=https://api.x.ai/v1
UNWH_MODEL_NAME=grok-4
# 32-byte key, base64-encoded. Encrypts TOTP secrets at rest.
UNWH_TOTP_KEY=
# off | warn | enforce. off does not check admin MFA.
UNWH_ADMIN_MFA=off
# App-reviewer password sign-in for the OAuth page. Leave both unset to disable it.
# Set them only in the server environment. Never commit a real email or password.
# REVIEWER_PASSWORD must be at least 12 characters. It is compared in memory and not stored.
# REVIEWER_EMAIL is the one account that can use the password. Everyone else still gets a magic link.
# Use a dedicated non-staff, non-admin mailbox. The first successful sign-in creates that user if needed.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
# Organization id that receives approved preview users as clients. Approval fails until this is set.
# It never grants staff or admin. Leave unset until the trial org exists.
UNWH_TRIAL_ORG_ID=
# Owner email when someone requests access. Leave unset. "1" turns sending on; anything else stays off.
# UNWH_ACCESS_REQUEST_NOTIFY=1
# UNWH_ACCESS_REQUEST_NOTIFY_TO=
