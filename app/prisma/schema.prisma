generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  prospect
  client
  staff
}
enum MembershipStatus {
  invited
  active
  suspended
}
enum EngagementKind {
  workflow_check
  capped_hours_4
  capped_hours_8
  fixed_price
  hourly
}
enum PricingModel {
  workflow_check
  capped_hours
  fixed_price
  hourly
}
enum RecordStatus {
  draft
  pending_approval
  active
  on_hold
  closed
}
enum ChatAgent {
  proposal
  contract
  project_manager
}
enum ChatStatus {
  open
  human_held
  closed
}
enum ChatRole {
  user
  assistant
  human
  system
}
enum ContractStatus {
  draft
  sent
  signed
  cancelled
}
enum BillingTrigger {
  contract_signed
  milestone_accepted
  manual
}
enum InvoiceStatus {
  draft
  sent
  paid
  void
  overdue
}
enum ProjectStatus {
  planned
  active
  blocked
  complete
}
enum MilestoneStatus {
  planned
  in_progress
  submitted
  accepted
  blocked
}
enum TaskStatus {
  todo
  in_progress
  blocked
  done
}
enum ChangeOrderStatus {
  pending
  approved
  rejected
}
enum EscalationStatus {
  open
  claimed
  resolved
}
enum ApprovalKind {
  pricing
  change_order
}
enum ApprovalStatus {
  pending
  approved
  rejected
}
enum ScheduleAmountRule {
  percent_of_total
  zero
}
enum LeftoverCentTarget {
  last_entry
}
enum UnscopedRemainderRule {
  sole_or_final_milestone
}
enum RetainagePolicy {
  add_on_accept
}

enum CatalogVersionStatus {
  draft
  published
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  displayName String
  isAdmin Boolean @default(false)
  totpSecretEnc String?
  totpEnabledAt DateTime?
  totpRecoveryHashes String[] @default([])
  /// Set while an admin has suspended the account. Magic-link and password sign-in treat this like an unknown email.
  suspendedAt DateTime?
  createdAt DateTime @default(now())
  memberships Membership[]
  ownedProposals Proposal[] @relation("ProposalOwner")
  assignedTasks Task[] @relation("TaskAssignee")
  requestedChangeOrders ChangeOrder[] @relation("ChangeOrderRequester")
  assignedEscalations Escalation[] @relation("EscalationAssignee")
  approvals Approval[] @relation("ApprovalDecider")
  auditEvents AuditEvent[] @relation("AuditActor")
  chatSessions ChatSession[]
  mcpTokens McpToken[]
  timeEntries TimeEntry[]
  uploadedProposalAttachments ProposalAttachment[]
  guestInvites ProposalGuestInvite[]
}

model AccessRequest {
  id String @id @default(uuid()) @db.Uuid
  email String
  name String
  company String?
  role String?
  reason String
  referral String?
  status AccessRequestStatus @default(pending)
  reviewedBy String? @db.Uuid
  reviewedAt DateTime?
  reviewNote String?
  createdAt DateTime @default(now())
  ip String?
  userAgent String?
  @@index([email, status])
  @@index([status, createdAt])
}

model MagicLink {
  id String @id @default(uuid()) @db.Uuid
  email String
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  requestIp String?
  userAgent String?
  @@index([email, expiresAt])
  @@index([expiresAt])
}

model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  createdAt DateTime @default(now())
  memberships Membership[]
  proposals Proposal[]
  contracts Contract[]
  projects Project[]
  auditEvents AuditEvent[]
  mcpClients McpClient[]
  contractCredits ContractCredit[]
}

model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  organizationId String @db.Uuid
  role Role
  status MembershipStatus @default(invited)
  permissions Json @default("[]")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model McpClient {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  clientId String @unique
  name String
  redirectUris Json @default("[]")
  scopes Json @default("[]")
  secretHash String?
  createdAt DateTime @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tokens McpToken[]
}

model McpToken {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  userId String? @db.Uuid
  tokenHash String @unique
  scopes Json @default("[]")
  expiresAt DateTime?
  refreshTokenHash String? @unique
  refreshExpiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  client McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([clientId, revokedAt])
}

model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  userId String? @db.Uuid
  requestId String
  operation String
  response Json
  createdAt DateTime @default(now())
  expiresAt DateTime?
  @@unique([organizationId, requestId, operation])
  @@index([expiresAt])
}

model Proposal {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  ownerId String @db.Uuid
  title String
  engagement EngagementKind
  status RecordStatus @default(draft)
  scope Json
  timeline Json
  pricingModel PricingModel
  pricing Json
  version Int @default(1)
  /// Stored deadline. Not enforced: proposals do not expire. Migration 0055 clears this and drops the insert trigger.
  validUntil DateTime? @map("valid_until")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner User @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  options ProposalOption[]
  optionGroups ProposalOptionGroup[]
  milestones TimelineMilestone[]
  chatSessions ChatSession[]
  contracts Contract[]
  publicLinks ProposalPublicLink[]
  catalogVersionId String? @map("catalog_version_id") @db.Uuid
  catalogVersion CatalogVersion? @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  reviewState String @default("draft") @map("review_state")
  templateCode String @default("standard") @map("template_code")
  template ProposalTemplate @relation(fields: [templateCode], references: [code], onDelete: Restrict)
  approvedVersionId String? @map("approved_version_id") @db.Uuid
  approvedVersion ProposalVersion? @relation("ApprovedProposalVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  versions ProposalVersion[] @relation("ProposalVersions")
  reviewComments ProposalReviewComment[]
  reviewFlags ProposalReviewFlag[]
  reviewEvents ProposalReviewEvent[]
  reviewMeeting ProposalReviewMeeting?
  nodes ProposalNode[]
  nodeEdges ProposalNodeEdge[]
  completionEvents ProposalCompletionEvent[]
  parkedChanges ProposalParkedChange[]
  intakePark ProposalIntakePark[]
  views ProposalView[]
  approvalSteps ProposalApprovalStep[]
  roles ProposalRole[]
  attachments ProposalAttachment[]
  uploadParts ProposalUploadPart[]
  changeItems ProposalChangeItem[]
  guestInvites ProposalGuestInvite[]
  sourceDocuments ProposalSourceDocument[]
  requirements ProposalRequirement[]
  managerTasks ProposalManagerTask[]
  goNoGoAssessments ProposalGoNoGoAssessment[]
  scopeBaselines ProposalScopeBaseline[]
  pricingModels ProposalPricingModel[]
  complianceSignoffs ProposalComplianceSignoff[]
  contentLibraryUses ContentLibraryUse[]
  @@index([organizationId, status, updatedAt])
  @@index([catalogVersionId])
  @@index([reviewState])
}

/// Uploaded PDF or Markdown file stored with a proposal.
model ProposalAttachment {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  filename String
  contentType String @map("content_type")
  byteSize Int @map("byte_size")
  sha256 String
  bytes Bytes
  sourceUrl String? @map("source_url")
  uploadedById String @map("uploaded_by_id") @db.Uuid
  sortOrder Int @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  @@unique([proposalId, filename])
  @@index([proposalId, sortOrder])
  @@map("proposal_attachment")
}

/// One slice of a PDF or Markdown file, assembled into an attachment when every part has arrived.
model ProposalUploadPart {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  filename String
  partIndex Int @map("part_index")
  partCount Int @map("part_count")
  bytes Bytes
  createdAt DateTime @default(now()) @map("created_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@unique([proposalId, filename, partIndex])
  @@index([proposalId, filename])
  @@map("proposal_upload_part")
}

/// A pushback deadline, a formal pushback, or a change request, with the person who decides it.
model ProposalChangeItem {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  kind String
  summary String
  detail String @default("")
  approverName String @map("approver_name")
  dueAt DateTime? @map("due_at")
  status String @default("open")
  decision String?
  decisionNote String? @map("decision_note")
  decidedAt DateTime? @map("decided_at")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, kind, status])
  @@map("proposal_change_item")
}

/// A named client person who can open this proposal in the portal. Recording an invite does not send mail.
model ProposalGuestInvite {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  name String
  email String
  taskId String? @map("task_id") @db.Uuid
  status String @default("invited")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([proposalId, email])
  @@index([userId, status])
  @@map("proposal_guest_invite")
}

/// One opening of a proposal or one of its parts.
model ProposalView {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  viewerId String @db.Uuid
  sectionKey String? @map("section_key")
  seenAt DateTime @default(now()) @map("seen_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, seenAt])
  @@map("proposal_view")
}

/// Ordered people who must approve before the proposal can be approved. An empty chain keeps the single staff approval.
model ProposalApprovalStep {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  sortOrder Int @map("sort_order")
  label String
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  decision ProposalApproval?
  @@index([proposalId, sortOrder])
  @@map("proposal_approval_step")
}

model ProposalApproval {
  id String @id @default(uuid()) @db.Uuid
  stepId String @unique @map("step_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  step ProposalApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  @@map("proposal_approval")
}

/// Proposal-manager records are immutable-by-version snapshots for intake, requirements,
/// tasks, qualification, scope, and pricing. Domain-specific JSON keeps this additive
/// migration compatible with existing proposal documents while the workflows mature.
model ProposalSourceDocument {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  fileName String @map("file_name")
  mimeType String? @map("mime_type")
  content String
  status String @default("received")
  metadata Json @default("{}")
  extractedAt DateTime? @map("extracted_at")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, createdAt])
  @@map("proposal_source_document")
}

model ProposalRequirement {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  sourceDocumentId String? @map("source_document_id") @db.Uuid
  text String
  requirementType String @map("requirement_type")
  sourceReference String? @map("source_reference")
  mandatory Boolean @default(false)
  confidence Float @default(1)
  status String @default("unmapped")
  ownerId String? @map("owner_id") @db.Uuid
  dueAt DateTime? @map("due_at")
  priority String @default("normal")
  mappedNodeKeys String[] @default([]) @map("mapped_node_keys")
  suggestedNodeKeys String[] @default([]) @map("suggested_node_keys")
  duplicateOfId String? @map("duplicate_of_id") @db.Uuid
  confirmed Boolean @default(false)
  evidence Json @default("[]")
  reviewNote String? @map("review_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, status, mandatory])
  @@index([sourceDocumentId])
  @@map("proposal_requirement")
}

model ProposalComplianceSignoff {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  note String @default("")
  signedById String? @map("signed_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, createdAt])
  @@map("proposal_compliance_signoff")
}

model ProposalManagerTask {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  title String
  description String @default("")
  taskType String @map("task_type")
  status String @default("open")
  priority String @default("normal")
  ownerId String? @map("owner_id") @db.Uuid
  assigneeName String? @map("assignee_name")
  assigneeEmail String? @map("assignee_email")
  side String @default("us")
  sectionKey String? @map("section_key")
  requirementId String? @map("requirement_id") @db.Uuid
  dependsOnTaskId String? @map("depends_on_task_id") @db.Uuid
  dueAt DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  note String?
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, status, dueAt])
  @@index([ownerId, status, dueAt])
  @@map("proposal_manager_task")
}

model ProposalGoNoGoAssessment {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  status String @default("draft")
  decision String?
  score Int?
  factors Json @default("[]")
  rationale String?
  decidedById String? @map("decided_by_id") @db.Uuid
  decidedAt DateTime? @map("decided_at")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, status, updatedAt])
  @@map("proposal_go_no_go_assessment")
}

model ProposalScopeBaseline {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  version Int @default(1)
  status String @default("draft")
  items Json @default("[]")
  assumptions Json @default("[]")
  exclusions Json @default("[]")
  risks Json @default("[]")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@unique([proposalId, version])
  @@index([proposalId, createdAt])
  @@map("proposal_scope_baseline")
}

model ProposalPricingModel {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  version Int @default(1)
  currency String
  lines Json @default("[]")
  options Json @default("[]")
  totals Json @default("{}")
  approvalStatus String @default("draft") @map("approval_status")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@unique([proposalId, version])
  @@index([proposalId, createdAt])
  @@map("proposal_pricing_model")
}

model ContentLibraryItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  stableKey String @unique @map("stable_key")
  title String
  category String
  body Json
  tags String[] @default([])
  clientLabel String? @map("client_label")
  guidance String @default("")
  visibility String @default("organization")
  source String?
  industry String?
  product String?
  status String @default("draft")
  version Int @default(1)
  approvedVersion Int? @map("approved_version")
  ownerId String? @map("owner_id") @db.Uuid
  effectiveFrom DateTime? @map("effective_from")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  versions ContentLibraryVersion[]
  uses ContentLibraryUse[]
  @@index([organizationId, status, category])
  @@index([expiresAt])
  @@map("content_library_item")
}

model ContentLibraryVersion {
  id String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid
  version Int
  title String
  body Json
  guidance String @default("")
  tags String[] @default([])
  changeSummary String @default("") @map("change_summary")
  status String @default("draft")
  authorId String? @map("author_id") @db.Uuid
  approvedById String? @map("approved_by_id") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  supersededBy Int? @map("superseded_by")
  idempotencyKey String? @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at")
  item ContentLibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([itemId, version])
  @@unique([itemId, idempotencyKey])
  @@index([itemId, createdAt])
  @@map("content_library_version")
}

model ContentLibraryUse {
  id String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid
  version Int
  proposalId String @map("proposal_id") @db.Uuid
  sectionKey String @map("section_key")
  actorId String? @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  item ContentLibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([itemId, createdAt])
  @@index([proposalId])
  @@map("content_library_use")
}

/// Historical expiry settings. One row. Deadlines are not enforced; proposals do not expire.
model ProposalExpiryConfig {
  id String @id @db.Uuid
  defaultValidDays Int @map("default_valid_days")
  nearExpiryDays Int @map("near_expiry_days")
  extendDefaultDays Int @map("extend_default_days")
  extendMaxDays Int @map("extend_max_days")
  labelActive String @map("label_active")
  labelExpiring String @map("label_expiring")
  labelExpired String @map("label_expired")
  expiredMessage String @map("expired_message")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("proposal_expiry_config")
}
model ProposalPublicLink {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @db.Uuid
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId, revokedAt])
  @@index([expiresAt])
}

model ProposalOptionGroup {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  name String
  mode String
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  options ProposalOption[]
  @@index([proposalId])
  @@map("proposal_option_group")
}

model ProposalOption {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  label String
  description String
  priceDeltaMinor Int
  priceCurrency String
  selected Boolean @default(false)
  selection String @default("optional")
  groupId String? @db.Uuid
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  group ProposalOptionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  @@index([proposalId])
  @@index([groupId])
}

model TimelineMilestone {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  title String
  description String
  dueDate DateTime?
  weeksLow Int?
  weeksHigh Int?
  hoursLow Int?
  hoursHigh Int?
  gate String @default("")
  actualStart DateTime?
  actualEnd DateTime?
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  rolePhases ProposalRolePhase[]
  @@index([proposalId, dueDate])
}

/// Who does the work on a proposal. heaviestAll and heaviestGates cover the whole engagement or gate reviews; rolePhases names specific timeline phases.
model ProposalRole {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @map("proposal_id") @db.Uuid
  sortOrder Int @map("sort_order")
  name String
  side String
  responsibility String
  heaviestAll Boolean @default(false) @map("heaviest_all")
  heaviestGates Boolean @default(false) @map("heaviest_gates")
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  phases ProposalRolePhase[]
  @@index([proposalId, sortOrder])
  @@map("proposal_role")
}

model ProposalRolePhase {
  roleId String @map("role_id") @db.Uuid
  milestoneId String @map("milestone_id") @db.Uuid
  role ProposalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  milestone TimelineMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  @@id([roleId, milestoneId])
  @@map("proposal_role_phase")
}

model ChatSession {
  id String @id @default(uuid()) @db.Uuid
  ownerId String? @db.Uuid
  agent ChatAgent
  status ChatStatus @default(open)
  proposalId String? @db.Uuid
  publicTokenHash String? @unique
  contactEmail String?
  submittedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  escalations Escalation[]
  @@index([ownerId, status, updatedAt])
  @@index([publicTokenHash, status])
  @@index([expiresAt])
}

model ChatMessage {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  role ChatRole
  content String
  toolCallId String? @db.Uuid
