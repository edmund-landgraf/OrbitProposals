  purgedAt       DateTime?          @map("purged_at") @db.Timestamptz(6)
  tryMe          TryMe              @relation(fields: [tryMeCode], references: [code])
  calls          TryMeSessionCall[]

  @@index([ipHash, createdAt], map: "try_me_session_ip_created_idx")
  @@map("try_me_session")
}

model TryMeSessionCall {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  taskId       String        @map("task_id") @db.Uuid
  callId       String        @map("call_id") @db.Uuid
  status       String        @default("pending")
  summary      String?
  durationMs   Int?          @map("duration_ms")
  startedAt    DateTime?     @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?     @map("finished_at") @db.Timestamptz(6)
  agentTraceId String?       @map("agent_trace_id") @db.Uuid
  result       Json?
  session      TryMeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task         TryMeTask     @relation(fields: [taskId], references: [id])
  call         TryMeTaskCall @relation(fields: [callId], references: [id])

  @@unique([sessionId, callId], map: "try_me_session_call_key")
  @@map("try_me_session_call")
}

model ProposalReviewRule {
  code       String  @id
  nodeKey    String  @map("node_key")
  check      String
  fieldPath  String? @map("field_path")
  minChars   Int?    @map("min_chars")
  minItems   Int?    @map("min_items")
  pattern    String?
  severity   String
  weight     Int
  message    String
  suggestion String
  sort       Int     @default(0)
  active     Boolean @default(true)
  templateCode String? @map("template_code")
  template   ProposalTemplate? @relation(fields: [templateCode], references: [code], onDelete: Cascade)

  @@map("proposal_review_rule")
}

model ProposalTemplate {
  code String @id
  name String
  description String
  sortOrder Int @map("sort_order")
  active Boolean @default(true)
  suggestedPricingModel String? @map("suggested_pricing_model")
  outline Json @default("{}")
  nodes ProposalTemplateNode[]
  proposals Proposal[]
  reviewRules ProposalReviewRule[]
  samples ProposalTemplateSample[]
  options ProposalTemplateOption[]
  @@map("proposal_template")
}
model ProposalTemplateSample {
  templateCode String @map("template_code")
  nodeKey String @map("node_key")
  content Json
  template ProposalTemplate @relation(fields: [templateCode], references: [code], onDelete: Cascade)
  node ProposalNodeTemplate @relation(fields: [nodeKey], references: [key], onDelete: Cascade)
  @@id([templateCode, nodeKey])
  @@map("proposal_template_sample")
}
model ProposalTemplateOption {
  templateCode String @map("template_code")
  code String
  sortOrder Int @map("sort_order")
  label String
  description String
  selection String @default("optional")
  template ProposalTemplate @relation(fields: [templateCode], references: [code], onDelete: Cascade)
  @@id([templateCode, code])
  @@map("proposal_template_option")
}

model ProposalTemplateNode {
  templateCode String @map("template_code")
  nodeKey String @map("node_key")
  sortOrder Int @map("sort_order")
  parentKey String? @map("parent_key")
  template ProposalTemplate @relation(fields: [templateCode], references: [code], onDelete: Cascade)
  node ProposalNodeTemplate @relation(fields: [nodeKey], references: [key], onDelete: Restrict)
  @@id([templateCode, nodeKey])
  @@map("proposal_template_node")
}

model TryMeExercise {
  code String @id
  sort Int @default(0)
  title String
  goal String
  prompt String
  active Boolean @default(true)
  tools TryMeExerciseTool[]
  @@map("try_me_exercise")
}

model TryMeExerciseTool {
  exerciseCode String @map("exercise_code")
  toolName String @map("tool_name")
  exercise TryMeExercise @relation(fields: [exerciseCode], references: [code], onDelete: Cascade)
  @@id([exerciseCode, toolName])
  @@map("try_me_exercise_tool")
}

model ProposalSectionLibrary {
  nodeKey String @id @map("node_key")
  category String
  description String
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(true)
  node ProposalNodeTemplate @relation(fields: [nodeKey], references: [key], onDelete: Cascade)
  @@map("proposal_section_library")
}

model McpTokenSetting {
  code  String  @id
  value Int
  note  String?

  @@map("mcp_token_setting")
}

/// External e-signature provider request (SignWell, later BoldSign, etc). Test-mode only unless UNWH_ESIGN_LIVE=1.
model ContractEsignRequest {
  id String @id @default(uuid()) @db.Uuid
  contractId String @map("contract_id") @db.Uuid
  proposalVersionId String @map("proposal_version_id") @db.Uuid
  provider String
  providerDocumentId String @map("provider_document_id")
  uniqueKey String @unique @map("unique_key")
  status String @default("created")
  providerStatus Json @default("{}") @map("provider_status")
  testMode Boolean @default(true) @map("test_mode")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  proposalVersion ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  artifacts ContractEsignArtifact[]

  @@unique([contractId, proposalVersionId])
  @@index([provider, providerDocumentId])
  @@index([status, updatedAt])
  @@map("contract_esign_request")
}

/// Immutable artifacts for a completed e-sign request (signed PDF + audit trail/certificate).
model ContractEsignArtifact {
  id String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  kind String
  sha256 String
  bytes Bytes
  createdAt DateTime @default(now()) @map("created_at")

  request ContractEsignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind])
  @@index([requestId, createdAt])
  @@map("contract_esign_artifact")
}
