{
  "name": "orbit-proposals",
  "private": true,
  "version": "2.0.0",
  "description": "Orbit Proposals: the Unwhelm proposal manager extracted so it can live in its own repository. Multi-user work is planned, not implemented.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:web": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "build:shapes": "tsc -p packages/shapes/tsconfig.json",
    "build:api": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.api.json",
    "build:mcp": "npm --prefix unwh-mcp run build",
    "build:services": "npm run schemas:export && npm run build:api && npm run build:mcp",
    "build:all": "npm run build:web && npm run build:services",
    "schemas:export": "npm run build:shapes && node scripts/export-schemas.mjs",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:purge-expired": "tsx scripts/purge-expired.ts",
    "reminders:run": "tsx scripts/run-reminders.ts",
    "reminders:deliver": "tsx scripts/deliver-reminders.ts",
    "guidance:score": "tsx scripts/score-guidance-rules.ts",
    "test:scripted-proposal": "tsx scripts/scripted-proposal.ts",
    "mint:link": "tsx scripts/mint-magic-link.ts",
    "admin:grant": "tsx scripts/make-admin.ts",
    "org:attach": "tsx scripts/org-attach.ts",
    "db:migrate:production": "powershell -ExecutionPolicy Bypass -File scripts/migrate-production.ps1",
    "dev:api": "tsx --env-file=.env server/index.ts",
    "start:api": "node dist-api/server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test:smoke": "prisma generate --schema prisma/schema.prisma && playwright test",
    "test:axe": "playwright test tests/accessibility.spec.ts --workers=1",
    "test:production": "node scripts/production-smoke.mjs",
    "start": "node server.mjs",
    "postinstall": "prisma generate",
    "db:purge-demos": "tsx scripts/purge-demos.ts",
    "db:purge-traces": "tsx scripts/purge-agent-traces.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "lucide-react": "^0.561.0",
    "otplib": "^13.5.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.55.0",
    "@types/qrcode": "^1.5.6",
    "lighthouse": "^13.5.0",
    "pdfjs-dist": "^6.5.438",
    "tsx": "^4.23.15"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.9"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
